# Application
APP_NAME=SATQUERY AI
ENVIRONMENT=development
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./satquery.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/satquery

# AI Provider: demo, gemini, or openai_compatible
AI_PROVIDER=demo
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Storage: local or supabase
STORAGE_MODE=local
STORAGE_PATH=./storage
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=satquery

# CORS
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_MB=50
