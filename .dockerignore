# SATQUERY AI - Docker build context exclusions
# Keeps build contexts small and avoids sending secrets/node_modules

# Environment & secrets
.env
*.env
.env.*
!.env.example

# VCS
.git
.gitignore

# Backend
backend/.venv
backend/**/__pycache__
backend/**/*.pyc
backend/.pytest_cache
backend/tests
backend/satquery.db
backend/satquery.db-journal

# Frontend
frontend/node_modules
frontend/dist
frontend/.vite

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Editor/OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*